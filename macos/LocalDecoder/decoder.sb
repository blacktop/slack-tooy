(version 1)
(deny default)
(allow process-exec (literal (param "HELPER")))
(allow file-read-metadata)
(allow file-read-data file-map-executable
    (subpath "/System")
    (subpath "/usr/lib")
    (literal "/")
    (literal (param "HELPER"))
    (literal "/dev/null")
    (literal "/dev/random")
    (literal "/dev/urandom"))
(allow file-write-data (literal "/dev/null"))
(allow sysctl-read)
